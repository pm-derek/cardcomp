{
  "manifest_version": 3,
  "name": "CardComp to Whatnot",
  "version": "0.9.16",
  "description": "Tap a bid in CardComp and it lands in Whatnot's Custom bid box. You still place the bid.",
  "permissions": [
    "sidePanel",
    "storage",
    "activeTab",
    "declarativeNetRequest",
    "alarms"
  ],
  "host_permissions": [
    "https://*.whatnot.com/*",
    "https://www.tcgplayer.com/*",
    "https://pm-derek.github.io/*",
    "https://api.github.com/*",
    "https://api.anthropic.com/*",
    "https://tcgplayer-cdn.tcgplayer.com/*",
    "https://images.pokemontcg.io/*",
    "https://mpapi.tcgplayer.com/*",
    "https://mp-search-api.tcgplayer.com/*",
    "https://mpgateway.tcgplayer.com/*",
    "https://api.cardsight.ai/*",
    "https://store.tcgplayer.com/*",
    "https://sellerportal.tcgplayer.com/*",
    "https://tcgplayer-ims-image-upload-bucket-prd-us-east-1.s3.us-east-1.amazonaws.com/*",
    "https://tcgplayer-ims-image-upload-bucket-prd-us-east-1.s3.amazonaws.com/*"
  ],
  "options_page": "options.html",
  "background": {
    "service_worker": "bg.js"
  },
  "action": {
    "default_title": "CardComp",
    "default_icon": {
      "128": "icon.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.whatnot.com/*"
      ],
      "js": [
        "whatnot.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://pm-derek.github.io/cardcomp/*"
      ],
      "js": [
        "cardcomp.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.tcgplayer.com/product/*"
      ],
      "js": [
        "tcgplayer.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://*.whatnot.com/*"
      ],
      "js": [
        "recog/recog-whatnot.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://store.tcgplayer.com/admin/*"
      ],
      "js": [
        "feedback/badge.js",
        "feedback/feedback.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://sellerportal.tcgplayer.com/orders/*"
      ],
      "js": [
        "feedback/badge.js",
        "feedback/order.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://sellerportal.tcgplayer.com/messages*"
      ],
      "js": [
        "feedback/badge.js",
        "feedback/messages.js",
        "feedback/thread.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://sellerportal.tcgplayer.com/orders",
        "https://sellerportal.tcgplayer.com/orders?*"
      ],
      "js": [
        "feedback/badge.js",
        "feedback/orders.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://sellerportal.tcgplayer.com/scan-identify*"
      ],
      "js": [
        "scan/scan.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "128": "icon.png"
  },
  "commands": {
    "recog-grab": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Recognition: read the card on stream now (works anywhere in Chrome, side panel included)"
    }
  }
}
