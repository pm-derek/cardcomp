{
  "manifest_version": 3,
  "name": "CardComp to Whatnot",
  "version": "0.7.1",
  "description": "Tap a bid in CardComp and it lands in Whatnot's Custom bid box. You still place the bid.",
  "permissions": [
    "sidePanel",
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://*.whatnot.com/*",
    "https://www.tcgplayer.com/*",
    "https://pm-derek.github.io/*",
    "https://api.github.com/*",
    "https://api.anthropic.com/*",
    "https://tcgplayer-cdn.tcgplayer.com/*",
    "https://images.pokemontcg.io/*"
  ],
  "options_page": "options.html",
  "background": {
    "service_worker": "bg.js"
  },
  "action": {
    "default_title": "CardComp",
    "default_icon": {
      "128": "icon.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.whatnot.com/*"
      ],
      "js": [
        "whatnot.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://pm-derek.github.io/cardcomp/*"
      ],
      "js": [
        "cardcomp.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.tcgplayer.com/product/*"
      ],
      "js": [
        "tcgplayer.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.whatnot.com/*"
      ],
      "js": [
        "recog/recog-whatnot.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "128": "icon.png"
  },
  "commands": {
    "recog-grab": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Recognition: read the card on stream now (works anywhere in Chrome, side panel included)"
    }
  }
}
